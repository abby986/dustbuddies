{
  "expo": {
    "name": "DustBuddiesApp",
    "slug": "DustBuddiesApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/dustbuddies-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/dustbuddies-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#7c98c7"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app needs access to your photos to upload images.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.abby986.DustBuddiesApp"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/dustbuddies-icon.png",
        "backgroundColor": "#7c98c7"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.abby986.DustBuddiesApp"
    },
    "web": {
      "favicon": "./assets/dustbuddies-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "1807aa0f-38f6-41ed-bf1e-da6d1ff48ba7"
      }
    }
  }
}